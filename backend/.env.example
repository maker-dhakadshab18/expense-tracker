# Copy to .env (gitignored). Used for local dev, tests and running migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# A SEPARATE database — tests drop and recreate every table in it.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/expense_test?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
